params {
    reads = null                 // glob for paired reads, e.g. "/var/lib/docker/ppr/reads/*_{R1_val_1,R2_val_2}.fq.gz"
    outdir = "results"
    run_deepvariant = true

    // Reference data (staged as task inputs, no bind mounts needed)
    graph_dir = "/var/lib/docker/ppr/graph"
    graph_gbz = "${params.graph_dir}/hprc-v1.1-mc-grch38.gbz"
    graph_hapl = "${params.graph_dir}/hprc-v1.1-mc-grch38.hapl"
    reference_fasta = "/var/lib/docker/ppr/ref/GRCh38.chr.fasta"

    // Half the box per heavy task so two samples overlap on one host.
    cpus_per_task = Math.max(4, Runtime.runtime.availableProcessors().intdiv(2))
    mem_per_task = 140.GB

    // GPU for DeepVariant: index passed by run.sh (least-loaded free card on the host).
    gpu = "0"
    docker_gpu_opts = "--runtime=nvidia -e NVIDIA_VISIBLE_DEVICES=${params.gpu}"

    // Intermediates (gam, pack, surjected bam) are symlinked, finals copied.
    publish_intermediate = "symlink"
}

process {
    executor = 'local'
    cpus = 4
    memory = 8.GB
    errorStrategy = 'retry'
    maxRetries = 1

    withName: 'KMC_COUNT|HAPLOTYPE_SAMPLING|VG_GIRAFFE|VG_PACK|VG_CALL|VG_SURJECT|BAM_PREPROCESSING' {
        cpus = { params.cpus_per_task }
        memory = { params.mem_per_task }
    }

    // make_examples is 80% of DeepVariant wall time and scales with shards: whole box.
    withName: 'DEEPVARIANT' {
        cpus = { Runtime.runtime.availableProcessors() }
        memory = { params.mem_per_task }
    }
}

docker {
    enabled = true
    runOptions = "--user \$(id -u):\$(id -g)"
}

profiles {
    // Paper's original box layout (kept for reference runs elsewhere).
    paper {
        params.graph_dir = "/mnt/genomics/HPRC_v1.1_default"
        params.graph_hapl = "/mnt/genomics/HPRC_v1.1_default/graph.hapl"
        params.reference_fasta = "/mnt/genomics/illumina/ref_chr/Homo_sapiens.GRCh38.dna.primary_assembly.fasta"
        params.docker_gpu_opts = "--gpus all"
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag.html";        overwrite = true }
